<% flash.each do |name, message| %>
  <%= tag.div class: ["alert", "alert-#{name}", "alert-dismissible", "fade", "show"], role: "alert" do %>
    <%= message %>

    <button
      type="button"
      class="btn-close"
      data-bs-dismiss="alert"
      aria-label="Close"
    ></button>
  <% end %>
<% end %>
