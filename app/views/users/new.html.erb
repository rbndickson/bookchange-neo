<div class="row justify-content-center">
  <div class="col-12 col-md-10 col-lg-8 col-xl-6">
    <h3>Sign Up</h3>
    <hr>

    <%= form_with model: @user do |form| %>
      <div class="row mb-3">
        <%= form.label :email, "Email", class: "col-sm-5 col-form-label" %>

        <div class="col-sm-7">
          <%= form.email_field :email, class: form_control_class(@user, :email) %>
          <%= render "shared/field_errors", record: @user, attribute: :email %>
        </div>
      </div>

      <div class="row mb-3">
        <%= form.label :username, "Username", class: "col-sm-5 col-form-label" %>

        <div class="col-sm-7">
          <%= form.text_field :username, class: form_control_class(@user, :username) %>
          <%= render "shared/field_errors", record: @user, attribute: :username %>
        </div>
      </div>

      <div class="row mb-3">
        <%= form.label :password, "Password", class: "col-sm-5 col-form-label" %>

        <div class="col-sm-7">
          <%= form.password_field :password, class: form_control_class(@user, :password) %>
          <%= render "shared/field_errors", record: @user, attribute: :password %>
        </div>
      </div>

      <div class="row mb-3">
        <%= form.label :password_confirmation, "Confirm Password", class: "col-sm-5 col-form-label" %>

        <div class="col-sm-7">
          <%= form.password_field :password_confirmation,
                class: form_control_class(@user, :password_confirmation) %>

          <%= render "shared/field_errors", record: @user, attribute: :password_confirmation %>
        </div>
      </div>

      <div class="text-end">
        <%= form.submit "Sign Up", class: "btn btn-primary" %>
      </div>
    <% end %>
  </div>
</div>
