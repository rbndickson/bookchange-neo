<div class="row justify-content-center">
  <div class="col-12 col-md-10 col-lg-8 col-xl-6">
    <h3>Update Account</h3>
    <hr>

    <%= form_with model: @user do |form| %>
      <div class="row mb-3">
        <%= form.label :email, "Email", class: "col-sm-5 col-form-label" %>

        <div class="col-sm-7">
          <%= form.email_field :email, class: form_control_class(@user, :email) %>
          <%= render "shared/field_errors", record: @user, attribute: :email %>
        </div>
      </div>

      <div class="row mb-3">
        <%= form.label :username, "Username", class: "col-sm-5 col-form-label" %>

        <div class="col-sm-7">
          <%= form.text_field :username, class: form_control_class(@user, :username) %>
          <%= render "shared/field_errors", record: @user, attribute: :username %>
        </div>
      </div>

      <div class="row mb-3">
        <%= form.label :current_password, "Current Password", class: "col-sm-5 col-form-label" %>

        <div class="col-sm-7">
          <%= form.password_field :current_password, class: form_control_class(@user, :current_password) %>
          <%= render "shared/field_errors", record: @user, attribute: :current_password %>
        </div>
      </div>

      <div class="d-flex justify-content-between align-items-center">
        <%= link_to "Change Password", edit_password_path %>
        <%= form.submit "Update", class: "btn btn-primary" %>
      </div>
    <% end %>
  </div>
</div>
